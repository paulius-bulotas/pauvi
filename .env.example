# Docker/production configuration.
# Copy to .env on the server. DO NOT commit .env.

DATA_ROOT=/srv/pauvi-data/pauvi
APP_HTTP_PORT=8081
MYSQL_HOST_PORT=3307

MYSQL_DATABASE=pauvi
MYSQL_USER=pauvi
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD

# Vite variables are PUBLIC and are embedded into the frontend build.
# Keep secrets in the backend only.
VITE_API_BASE_URL=/api
